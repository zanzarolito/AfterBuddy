# AfterBuddy — Caddyfile
#
# DEV (défaut) : écoute sur :80 en HTTP pur, aucun certificat requis.
#
# PROD : remplacez ":80" par votre vrai domaine, ex. "afterbuddy.monsite.fr"
#        Caddy obtiendra alors automatiquement un certificat Let's Encrypt.
#        Vérifiez que le port 443 est ouvert et que le DNS pointe vers ce serveur.

:80 {
    # Reverse-proxy l'API Fastify (SSE-aware — pas de buffering).
    handle /api/* {
        reverse_proxy api:3000 {
            flush_interval -1
            transport http {
                read_timeout  1h
                write_timeout 1h
            }
        }
    }

    # Sert la PWA React.
    handle {
        reverse_proxy web:80
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options        "DENY"
        Referrer-Policy        "strict-origin-when-cross-origin"
    }

    encode gzip
    log
}
